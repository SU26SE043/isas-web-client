# ISAS Web Client — copy to `.env.local` for local development.
# Gateway origin only (no trailing slash). Required for Auth API calls.
VITE_API_BASE_URL=https://your-gateway.example.com

# Mock data: practice, cv-analysis, enterprise, and payment use fixtures until wired.
# Auth is live API — see LIVE_API_DOMAINS in src/shared/mock/config.ts.
# When a domain is ready for real API, add it to LIVE_API_DOMAINS in that file.
