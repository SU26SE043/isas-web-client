# ISAS Web Client — copy to `.env.local` for local development.

# --- Local dev (recommended) ---
# Leave VITE_API_BASE_URL EMPTY. Browser calls same-origin `/api/v1/auth/*`
# and Vite rewrites them to Auth service `/auth/*` (see vite.config.ts).
# Start Auth: in isas-server run
#   `dotnet run --project src/services/Isas.AuthService`
# (default http://localhost:5174)
VITE_API_BASE_URL=
VITE_AUTH_PROXY_TARGET=http://localhost:5174

# --- Direct gateway (only when YARP routes for /api/v1/auth are configured) ---
# Do NOT point at an empty/tunnel gateway — Auth calls will fail (404/CORS).
# Prefer the local Vite proxy above until gateway reverse-proxy routes exist.
# VITE_API_BASE_URL=http://localhost:5050

# Mock data: practice, cv-analysis, profile, enterprise, payment, admin use fixtures
# until wired. Auth is always live API — never mocked in app code.

# Optional: enterprise SSO button
# VITE_ENABLE_ENTERPRISE_SSO=true

# Optional production error monitoring (Sentry)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
