# ISAS Web Client — copy to `.env.local` for local development.

# --- Local dev (recommended) ---
# Leave VITE_API_BASE_URL empty. Vite proxies /api/v1/auth/* -> Auth service.
# Start Auth: in isas-server run `dotnet run --project src/services/Isas.AuthService`
VITE_API_BASE_URL=
VITE_AUTH_PROXY_TARGET=http://localhost:5174

# --- Direct gateway (docker compose, when YARP routes are configured) ---
# VITE_API_BASE_URL=http://localhost:5050

# Mock data: practice, cv-analysis, enterprise, and payment use fixtures until wired.
# Auth is live API — see LIVE_API_DOMAINS in src/shared/mock/config.ts.
