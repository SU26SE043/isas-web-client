# ISAS Web Client — copy to `.env.local` for local development.

# --- Local dev (recommended) ---
# Leave VITE_API_BASE_URL EMPTY for Auth-only proxy, OR set gateway ORIGIN only.
# Must be origin without path — never end with `/api` or `/api/v1`
# (endpoint modules already include `/api/v1/...`).
# Example campaign URL when base is empty:
#   /api/v1/campaign/api/files/upload?fileType=cv
# Example with gateway:
#   http://localhost:5050/api/v1/campaign/api/files/upload?fileType=cv
VITE_API_BASE_URL=
VITE_AUTH_PROXY_TARGET=http://localhost:5174

# --- Direct gateway (Auth + Campaign + Interview) ---
# VITE_API_BASE_URL=http://localhost:5050

# Mock data: practice, profile, enterprise, payment, admin use fixtures until wired.
# `cv-analysis` is LIVE (Campaign APIs). Auth is always live.

# Optional: enterprise SSO button
# VITE_ENABLE_ENTERPRISE_SSO=true

# Optional production error monitoring (Sentry)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional: organization-controlled Photon geocoding instance or proxy.
# Low-volume development defaults to https://photon.komoot.io/api/
# VITE_PHOTON_API_URL=https://photon.example.com/api/
